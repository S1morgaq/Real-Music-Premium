{
  "name": "advanced-discord-music-bot",
  "version": "1.0.0",
  "description": "Ardmetra Music Gelismis Muzik Botu",
  "main": "dist/src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "start:all": "powershell -ExecutionPolicy Bypass -File scripts/start-all.ps1",
    "start:all:pm2": "powershell -ExecutionPolicy Bypass -File scripts/start-all.ps1 -Pm2",
    "deploy": "tsx scripts/deploy-commands.ts",
    "generate:ads": "tsx scripts/generate-ad-audio.ts",
    "preview:dashboard": "tsx scripts/dashboard-preview.ts",
    "redis:install:windows": "powershell -ExecutionPolicy Bypass -File scripts/install-redis-windows.ps1",
    "redis:start": "powershell -ExecutionPolicy Bypass -File scripts/start-redis.ps1",
    "seed:premium-codes": "tsx src/database/seedPremiumCodes.ts",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "docker:build": "docker build -t advanced-music-bot ."
  },
  "dependencies": {
    "@discordjs/rest": "^2.4.3",
    "@napi-rs/canvas": "^0.1.68",
    "chalk": "^4.1.2",
    "discord-api-types": "^0.37.115",
    "discord.js": "^14.17.3",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "kazagumo": "^3.2.2",
    "lyrics-finder": "^21.7.0",
    "mongoose": "^8.9.5",
    "ms": "^2.1.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "shoukaku": "^4.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/ms": "^0.7.34",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "ffmpeg-static": "^5.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
